generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Minimal production database foundation
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(USER)
  sessionVersion Int      @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  connections   Connection[]
  profile       ProfessionalProfile?
  generations   AIGeneration[]
  portfolios    PortfolioDocument[]
  publication   PortfolioPublication?
  jobs          Job[]
  resume        Resume?
}

enum Role {
  USER
  ADMIN
}

enum Provider {
  GITHUB
  LINKEDIN
}

enum SourceType {
  GITHUB
  LINKEDIN
  MANUAL
  RESUME
}

enum ConnectionState {
  NOT_CONNECTED
  CONNECTED
  IMPORTING
  SYNCED
  FAILED
}

model Connection {
  id           String          @id @default(cuid())
  userId       String
  provider     Provider
  state        ConnectionState @default(NOT_CONNECTED)
  externalId   String?
  accessToken  String?
  refreshToken String?
  scopes       String?
  lastSyncAt   DateTime?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawSnapshots RawSourceSnapshot[]

  @@unique([userId, provider])
}

model RawSourceSnapshot {
  id           String      @id @default(cuid())
  connectionId String
  data         String      
  createdAt    DateTime    @default(now())

  connection   Connection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model Resume {
  id              String    @id @default(cuid())
  userId          String    @unique
  fileUrl         String
  publicId        String
  originalFileName String
  mimeType        String
  fileSize        Int
  status          JobStatus @default(QUEUED)
  structuredData  String?   // JSON
  extractionError String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfessionalProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  
  fullName       String?
  headline       String?
  bio            String?
  location       String?
  avatarUrl      String?
  website        String?

  currentCompany String?
  jobTitle       String?
  
  githubUsername String?
  languages      String?   
  
  userEdits      String?   @default("{}")
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences    ProfessionalExperience[]
  education      ProfessionalEducation[]
  skills         ProfessionalSkill[]
  projects       ProfessionalProject[]
  certifications ProfessionalCertification[]
  links          ProfessionalLink[]
  portfolios     PortfolioDocument[]
}

model ProfessionalExperience {
  id               String     @id @default(cuid())
  profileId        String
  title            String
  company          String
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean    @default(false)
  description      String?
  
  source           SourceType @default(MANUAL)
  externalId       String?
  isManuallyEdited Boolean    @default(false)

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfessionalEducation {
  id               String     @id @default(cuid())
  profileId        String
  institution      String
  degree           String?
  fieldOfStudy     String?
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  description      String?
  
  source           SourceType @default(MANUAL)
  externalId       String?
  isManuallyEdited Boolean    @default(false)

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfessionalSkill {
  id               String     @id @default(cuid())
  profileId        String
  name             String
  
  source           SourceType @default(MANUAL)
  externalId       String?

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model ProfessionalProject {
  id               String     @id @default(cuid())
  profileId        String
  name             String
  description      String?
  url              String?
  repositoryUrl    String?
  technologies     String?
  startDate        DateTime?
  endDate          DateTime?
  
  source           SourceType @default(MANUAL)
  externalId       String?
  isManuallyEdited Boolean    @default(false)

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfessionalCertification {
  id               String     @id @default(cuid())
  profileId        String
  name             String
  organization     String
  issueDate        DateTime?
  expirationDate   DateTime?
  credentialId     String?
  credentialUrl    String?
  
  source           SourceType @default(MANUAL)
  externalId       String?
  isManuallyEdited Boolean    @default(false)

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfessionalLink {
  id               String     @id @default(cuid())
  profileId        String
  title            String
  url              String
  
  source           SourceType @default(MANUAL)
  externalId       String?
  isManuallyEdited Boolean    @default(false)

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

enum AIGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AIGeneration {
  id              String   @id @default(cuid())
  userId          String
  generationType  String
  provider        String
  model           String
  promptVersion   String
  status          AIGenerationStatus @default(PENDING)
  
  failureReason   String?
  result          String?  
  usage           String?  
  
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolios      PortfolioDocument[]
}

enum PortfolioStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PortfolioDocument {
  id                 String   @id @default(cuid())
  userId             String
  version            Int
  status             PortfolioStatus @default(DRAFT)
  
  content            String   // JSON string of structured portfolio
  sourceProfileId    String
  sourceAiGenerationId String?
  templateId         String   @default("editorial-v1")
  templateConfig     String?  // JSON string
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProfile      ProfessionalProfile @relation(fields: [sourceProfileId], references: [id])
  sourceAiGeneration AIGeneration?       @relation(fields: [sourceAiGenerationId], references: [id])
  publications       PortfolioPublication[]

  @@unique([userId, version])
}

model PortfolioPublication {
  id                  String   @id @default(cuid())
  userId              String   @unique
  portfolioDocumentId String
  publicSlug          String   @unique
  isActive            Boolean  @default(true)
  
  publishedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioDocument   PortfolioDocument @relation(fields: [portfolioDocumentId], references: [id])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventName   String
  userId      String?
  requestId   String?
  entityType  String?
  entityId    String?
  metadata    String?  // JSON string of sanitized metadata
  
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([eventName, createdAt])
  @@index([userId, createdAt])
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Job {
  id           String    @id @default(cuid())
  userId       String
  type         String
  status       JobStatus @default(QUEUED)
  
  payload      String?   // JSON
  result       String?   // JSON
  errorCode    String?
  errorMessage String?
  
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  
  availableAt  DateTime  @default(now())
  lockedAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  
  idempotencyKey String?   @unique

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([userId, createdAt])
  @@index([type, status])
}
