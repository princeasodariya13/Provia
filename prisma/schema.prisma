generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal production database foundation
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  connections   Connection[]
  profile       ProfessionalProfile?
  generations   AIGeneration[]
}

enum Role {
  USER
  ADMIN
}

enum Provider {
  GITHUB
  LINKEDIN
}

enum SourceType {
  GITHUB
  LINKEDIN
  MANUAL
}

enum ConnectionState {
  NOT_CONNECTED
  CONNECTED
  IMPORTING
  SYNCED
  FAILED
}

model Connection {
  id           String          @id @default(cuid())
  userId       String
  provider     Provider
  state        ConnectionState @default(NOT_CONNECTED)
  externalId   String?
  accessToken  String?
  refreshToken String?
  scopes       String?
  lastSyncAt   DateTime?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawSnapshots RawSourceSnapshot[]

  @@unique([userId, provider])
}

model RawSourceSnapshot {
  id           String      @id @default(cuid())
  connectionId String
  data         String      
  createdAt    DateTime    @default(now())

  connection   Connection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model ProfessionalProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  
  fullName       String?
  headline       String?
  bio            String?
  location       String?
  avatarUrl      String?
  website        String?

  currentCompany String?
  jobTitle       String?
  
  githubUsername String?
  languages      String?   
  
  userEdits      String?   @default("{}")
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences    ProfessionalExperience[]
  education      ProfessionalEducation[]
  skills         ProfessionalSkill[]
  projects       ProfessionalProject[]
  certifications ProfessionalCertification[]
  links          ProfessionalLink[]
}

model ProfessionalExperience {
  id               String     @id @default(cuid())
  profileId        String
  title            String
  company          String
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean    @default(false)
  description      String?
  
  source           SourceType @default(MANUAL)
  externalId       String?
  isManuallyEdited Boolean    @default(false)

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfessionalEducation {
  id               String     @id @default(cuid())
  profileId        String
  institution      String
  degree           String?
  fieldOfStudy     String?
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  description      String?
  
  source           SourceType @default(MANUAL)
  externalId       String?
  isManuallyEdited Boolean    @default(false)

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfessionalSkill {
  id               String     @id @default(cuid())
  profileId        String
  name             String
  
  source           SourceType @default(MANUAL)
  externalId       String?

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model ProfessionalProject {
  id               String     @id @default(cuid())
  profileId        String
  name             String
  description      String?
  url              String?
  repositoryUrl    String?
  technologies     String?
  startDate        DateTime?
  endDate          DateTime?
  
  source           SourceType @default(MANUAL)
  externalId       String?
  isManuallyEdited Boolean    @default(false)

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfessionalCertification {
  id               String     @id @default(cuid())
  profileId        String
  name             String
  organization     String
  issueDate        DateTime?
  expirationDate   DateTime?
  credentialId     String?
  credentialUrl    String?
  
  source           SourceType @default(MANUAL)
  externalId       String?
  isManuallyEdited Boolean    @default(false)

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfessionalLink {
  id               String     @id @default(cuid())
  profileId        String
  title            String
  url              String
  
  source           SourceType @default(MANUAL)
  externalId       String?
  isManuallyEdited Boolean    @default(false)

  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

enum AIGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AIGeneration {
  id              String   @id @default(cuid())
  userId          String
  generationType  String
  provider        String
  model           String
  promptVersion   String
  status          AIGenerationStatus @default(PENDING)
  
  failureReason   String?
  result          String?  
  usage           String?  
  
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
